# Copy to .env (git-ignored) and fill in. Used by vagrant-env when running `vagrant up`.

# Your fork, as owner/name, e.g. octocat/appsec-demon
GITHUB_REPOSITORY=owner/appsec-demon
# Fine-grained personal access token limited to that repository, with
# "Administration: Read and write" (needed to create runner registration tokens).
# Revoke it after both runners are registered.
GITHUB_TOKEN=github_pat_xxx

# Network is bridged, so pick two free addresses in your subnet
CI_CD_SERVER_IP=192.168.1.50
PROD_SERVER_IP=192.168.1.51
# Host network interface with internet access, e.g. wlp0s20f3 or en0
NIC=en0
