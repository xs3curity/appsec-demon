# Add project id and gitlab access token with permission of creating runner
# and rename it to .env
PROJECT_ID=project id
GITLAB_ACCESS_TOKEN=your access token
CI_CD_SERVER_IP=Network will be bridge, so you need an empty address from your subnet
PROD_SERVER_IP=Network will be bridge, so you need an empty address from your subnet
NIC=your network interface with internet connection, example: wlp0s20f3
