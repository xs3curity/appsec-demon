# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.env.enable

  config.vm.provision "shell", inline: <<-SHELL
    # Install Docker engine
    apt-get update && apt-get upgrade -y
    apt-get install ca-certificates curl gnupg
    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
    chmod a+r /etc/apt/keyrings/docker.gpg
    echo \
      "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu \
      $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | \
      tee /etc/apt/sources.list.d/docker.list > /dev/null
    apt-get update
    apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin docker-compose
    # Install Gitlab runners
    curl -L "https://packages.gitlab.com/install/repositories/runner/gitlab-runner/script.deb.sh" | bash
    apt-get install -y gitlab-runner jq git
    usermod -aG docker gitlab-runner
  SHELL

  config.vm.define "ci_cd" do |ci_cd|
    ci_cd.vm.provider "virtualbox" do |vb|
      vb.name = "ci_cd_server"
      vb.gui = false
      vb.memory = "1024"
      vb.cpus = 1
    end

    ci_cd.vm.provision "shell" do |shell|
      shell.env = {"PROJECT_ID" => ENV['PROJECT_ID'], "GITLAB_ACCESS_TOKEN" => ENV['GITLAB_ACCESS_TOKEN']}
      shell.inline = <<-SHELL
      TOKEN=$(curl --silent --request POST --url "https://gitlab.com/api/v4/user/runners" --data "runner_type=project_type" --data "project_id=$PROJECT_ID" --data "description=ci_cd_server" --data "tag_list=CI-CD" --header "PRIVATE-TOKEN: $GITLAB_ACCESS_TOKEN" | jq .token | sed 's/"//g')
      gitlab-runner register --non-interactive --name="CI_CD_Server" --url="https://gitlab.com"   --token="$TOKEN" --executor="shell"
      SHELL
    end
  end

  config.vm.define "prod" do |prod|
    prod.vm.provider "virtualbox" do |vb|
      vb.name = "prod_server"
      vb.gui = false
      vb.memory = "1024"
      vb.cpus = 1
    end

    prod.vm.provision "shell" do |shell|
      shell.env = {"PROJECT_ID" => ENV['PROJECT_ID'], "GITLAB_ACCESS_TOKEN" => ENV['GITLAB_ACCESS_TOKEN']}
      shell.inline = <<-SHELL
      TOKEN=$(curl --silent --request POST --url "https://gitlab.com/api/v4/user/runners" --data "runner_type=project_type" --data "project_id=$PROJECT_ID" --data "description=prod_server" --data "tag_list=prod-deploy" --header "PRIVATE-TOKEN: $GITLAB_ACCESS_TOKEN" | jq .token | sed 's/"//g')
      gitlab-runner register --non-interactive --name="Prod_Server" --url="https://gitlab.com"   --token="$TOKEN" --executor="shell"
      SHELL
    end
  end
end
